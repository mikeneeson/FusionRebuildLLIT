#!/bin/bash
# Capture what is on the player's screen right now, as a PNG.
#
#   luckylogic-screenshot              PNG to stdout
#   luckylogic-screenshot out.png      PNG to a file
#
# From another machine:
#   ssh <admin>@<player-ip> sudo luckylogic-screenshot > screen.png
#
# Works by talking to cage's Wayland socket with grim, so it captures the
# real composited output, exactly what the TV shows.
set -euo pipefail

if [ "$(id -un)" != "player" ]; then
    if [ "$(id -u)" -eq 0 ]; then
        exec runuser -u player -- "$0" "$@"
    fi
    echo "error: run as root (sudo) or as the player user" >&2
    exit 1
fi

uid="$(id -u)"
export XDG_RUNTIME_DIR="/run/user/$uid"

sock=""
for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    case "$s" in *.lock) continue ;; esac
    if [ -S "$s" ]; then
        sock="$(basename "$s")"
        break
    fi
done

if [ -z "$sock" ]; then
    echo "error: no Wayland socket found. Is luckylogic-kiosk running?" >&2
    echo "       systemctl status luckylogic-kiosk" >&2
    exit 1
fi

export WAYLAND_DISPLAY="$sock"
exec grim "${1:--}"
