[Unit]
Description=LuckyLogic Player kiosk
After=systemd-user-sessions.service network.target
# The tty1 login prompt and the kiosk both want the console. Only one of them
# can have it, and it is not the login prompt.
Conflicts=getty@tty1.service
After=getty@tty1.service
# Never stop trying to restart. A box in a studio has to come back on its own.
StartLimitIntervalSec=0

[Service]
Type=simple
User=player
Group=player

# PAMName=login is what gets a proper logind session, which is what gives the
# player user a seat and the /run/user/<uid> directory that Wayland needs.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

# These two must stay off. With either one enabled systemd hangs up the tty as
# the service starts, the kiosk takes SIGHUP immediately, and the unit spins in
# a restart loop that looks exactly like a crash. Do not turn them on.
TTYReset=no
TTYVHangup=no

UtmpIdentifier=tty1
UtmpMode=user

RuntimeDirectory=luckylogic
RuntimeDirectoryMode=0755

ExecStart=/opt/luckylogic/bin/kiosk-launch
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
